APP_NAME="Python Backend"

# PostgreSQL：填写你新建的数据库信息
DB_HOST="127.0.0.1"
DB_PORT=5432
DB_NAME="python_backend"
DB_USER="postgres"
# 在本地 .env 中填写实际密码，不要提交到 Git
DB_PASSWORD=""

# Redis 与 JWT 认证
REDIS_URL="redis://127.0.0.1:6379/0"
# 用 `uv run python -c 'import secrets; print(secrets.token_hex(32))'` 生成
JWT_SECRET="replace-with-a-random-secret"
JWT_EXPIRE_SECONDS=3600

# OpenAI SDK / 千问兼容接口；AI_API_KEY
AI_API_KEY=
AI_BASE_URL=https://maas.qianwenapi.com/compatible-mode/v1
AI_MODEL=qwen3.8-max
AI_TIMEOUT_MS=120000
AI_MAX_TOKENS=2048
AI_CONTEXT_MAX_BYTES=24000
# 可选模型白名单（需包含 AI_MODEL）
# AI_MODELS=[{"id":"qwen3.8-max","label":"Qwen","reasoningEfforts":[],"defaultEffort":"auto"}]
# 聊天模型自动调用图片生成工具；图片模型 ID 以服务商实际提供的为准
AI_IMAGE_TOOLS_ENABLED=true
AI_IMAGE_MODEL=qwen-image-3.0-pro
# 图片原生接口完整 URL（直接请求，不拼接路径）；图片密钥留空时复用 AI_API_KEY
AI_IMAGE_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/api/v1/services/aigc/multimodal-generation/generation
AI_IMAGE_API_KEY=
# 留空不启用聊天 RAG；密钥留空时复用聊天密钥
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
